-- ============================================================================
-- SPACE QUERY MARIADB AUTO-FORMAT CERTIFICATION GAUNTLET II
-- Target: MariaDB 12.2+
--
-- Complementary boss: VECTOR data/indexes, UUID v7, INET6, application-time
-- PERIODs and WITHOUT OVERLAPS, FOR PORTION OF DML, anchored row types, explicit
-- and implicit cursor FOR loops, reverse ranges, EXECUTE IMMEDIATE USING,
-- EXCEPT ALL, FETCH WITH TIES, and rollback-only RETURNING result sets.
-- ============================================================================

DELIMITER ;
DROP DATABASE IF EXISTS sq_mariadb_format_cert_2;
CREATE DATABASE sq_mariadb_format_cert_2 CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE sq_mariadb_format_cert_2;
SET NAMES utf8mb4;
SET SESSION sql_mode='STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION';
SET @lexical_trap='VECTOR(3) PERIOD FOR x(a,b) WITHOUT OVERLAPS // UUID_v7() -- inert';

# comment trap: FOR rec IN(cur()) DO END FOR; DELETE FOR PORTION OF //
/* Strings below may contain '[1,2,3]', '$.tags[*]', '?', and delimiter text. */

CREATE TABLE mb_asset(
asset_id INT NOT NULL,
asset_uuid [[UUID]] NOT NULL DEFAULT(UUID_v7()),
asset_code VARCHAR(40)NOT NULL,
embedding [[VECTOR]](3)NOT NULL,
metadata JSON NOT NULL,
created_at TIMESTAMP(6)NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
PRIMARY KEY(asset_id),
UNIQUE KEY uk_mb_asset_uuid(asset_uuid),
UNIQUE KEY uk_mb_asset_code(asset_code),
VECTOR [[INDEX]] [[ix_mb_asset_embedding]](embedding)[[M]]=4 [[DISTANCE]]=[[cosine]],
CONSTRAINT chk_mb_asset_metadata CHECK(JSON_VALID(metadata))
)ENGINE=InnoDB;

CREATE TABLE mb_price(
asset_id INT NOT NULL,
valid_from DATE NOT NULL,
valid_to DATE NOT NULL,
price DECIMAL(14,2)NOT NULL,
currency CHAR(3)NOT NULL,
source_doc JSON NOT NULL,
PERIOD FOR [[validity]](valid_from,valid_to),
PRIMARY KEY(asset_id,validity WITHOUT OVERLAPS),
KEY ix_mb_price_currency(currency),
CONSTRAINT chk_mb_price_positive CHECK(price>0),
CONSTRAINT chk_mb_price_source CHECK(JSON_VALID(source_doc))
)ENGINE=InnoDB;

CREATE TABLE mb_observation(
observation_id BIGINT NOT NULL AUTO_INCREMENT,
asset_id INT NOT NULL,
observed_at DATETIME(6)NOT NULL,
source_ip [[INET6]] NOT NULL,
metrics JSON NOT NULL,
temperature DECIMAL(8,3)AS(JSON_VALUE(metrics,'$.temperature'))PERSISTENT,
PRIMARY KEY(observation_id),
KEY ix_mb_observation_asset_time(asset_id,observed_at),
KEY ix_mb_observation_temperature(temperature),
CONSTRAINT chk_mb_observation_metrics CHECK(JSON_VALID(metrics))
)ENGINE=InnoDB;

CREATE TABLE mb_rollup(
asset_id INT NOT NULL,
observation_count BIGINT NOT NULL,
price_version_count BIGINT NOT NULL,
average_temperature DECIMAL(12,3),
evidence JSON NOT NULL,
PRIMARY KEY(asset_id)
)ENGINE=InnoDB;

CREATE TABLE mb_error_log(
log_id BIGINT NOT NULL AUTO_INCREMENT,
phase_name VARCHAR(80)NOT NULL,
sql_state CHAR(5),
error_no INT,
message_text TEXT,
PRIMARY KEY(log_id)
)ENGINE=InnoDB;

INSERT INTO mb_asset(asset_id,asset_code,embedding,metadata)VALUES
(1,'alpha',[[VEC_FromText]]('[1,2,3]'),JSON_OBJECT('region','KR','tags',JSON_ARRAY('edge','vip'))),
(2,'beta',[[VEC_FromText]]('[2,2,2]'),JSON_OBJECT('region','US','tags',JSON_ARRAY('core'))),
(3,'gamma',[[VEC_FromText]]('[0,1,0]'),JSON_OBJECT('region','DE','tags',JSON_ARRAY('edge','archive')));

INSERT INTO mb_price(asset_id,valid_from,valid_to,price,currency,source_doc)VALUES
(1,'2026-01-01','2026-12-31',100,'USD',JSON_OBJECT('source','initial','revision',1)),
(2,'2026-01-01','2026-06-01',80,'USD',JSON_OBJECT('source','initial','revision',1)),
(2,'2026-06-01','2026-12-31',90,'USD',JSON_OBJECT('source','renewal','revision',2)),
(3,'2026-01-01','2026-12-31',200,'EUR',JSON_OBJECT('source','initial','revision',1));

UPDATE mb_price [[FOR]] [[PORTION]] [[OF]] validity [[FROM]]'2026-03-01'[[TO]]'2026-06-01'
SET price=125,source_doc=JSON_SET(source_doc,'$.source','campaign','$.revision',2)
WHERE asset_id=1;

