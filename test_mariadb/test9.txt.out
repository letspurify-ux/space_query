-- ============================================================================
-- SPACE QUERY MARIADB AUTO-FORMAT CERTIFICATION GAUNTLET
-- Target: MariaDB 12.2+
--
-- Deliberately hostile layout: keep the strange spacing and split structural
-- owners in this source. The formatter, not a human, must normalize it. The
-- script is self-contained and its last result reports status = PASS.
-- ============================================================================

DELIMITER ;
DROP DATABASE IF EXISTS sq_mariadb_format_cert;
CREATE DATABASE sq_mariadb_format_cert CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE sq_mariadb_format_cert;
SET NAMES utf8mb4;
SET SESSION sql_mode='STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION';
SET @delimiter_trap='BEGIN; END// DELIMITER $$ -- still a string';

# comment trap: ; // $$ CREATE PROCEDURE imaginary() BEGIN END
/* nested-looking text is inert: SELECT '('; BEGIN IF x THEN END IF; END // */

CREATE SEQUENCE mf_event_seq START WITH 100 INCREMENT BY 1 MINVALUE 100 CACHE 20;

CREATE TABLE mf_department(
dept_id INT NOT NULL,
parent_dept_id INT NULL,
dept_name VARCHAR(80) NOT NULL,
properties BLOB NOT NULL,
PRIMARY KEY(dept_id),
UNIQUE KEY uk_mf_department_name(dept_name),
KEY ix_mf_department_parent(parent_dept_id),
CONSTRAINT fk_mf_department_parent FOREIGN KEY(parent_dept_id)REFERENCES mf_department(dept_id),
CONSTRAINT chk_mf_department_self CHECK(parent_dept_id IS NULL OR parent_dept_id<>dept_id)
)ENGINE=InnoDB;

CREATE TABLE mf_account(
account_id INT NOT NULL,
dept_id INT NOT NULL,
account_code VARCHAR(30) NOT NULL,
display_name VARCHAR(100) NOT NULL,
settings JSON NOT NULL,
row_start TIMESTAMP(6)GENERATED ALWAYS AS ROW START,
row_end TIMESTAMP(6)GENERATED ALWAYS AS ROW END,
PERIOD FOR SYSTEM_TIME(row_start,row_end),
PRIMARY KEY(account_id),
UNIQUE KEY uk_mf_account_code(account_code),
KEY ix_mf_account_dept(dept_id),
CONSTRAINT fk_mf_account_dept FOREIGN KEY(dept_id)REFERENCES mf_department(dept_id),
CONSTRAINT chk_mf_account_settings CHECK(JSON_VALID(settings))
)ENGINE=InnoDB WITH SYSTEM VERSIONING;

CREATE TABLE mf_event(
event_id BIGINT NOT NULL DEFAULT(NEXT VALUE FOR mf_event_seq),
event_key VARCHAR(40) NOT NULL,
account_id INT NOT NULL,
event_type VARCHAR(20) NOT NULL,
amount DECIMAL(14,2)NOT NULL,
payload JSON NOT NULL,
occurred_at DATETIME(6)NOT NULL,
channel_code VARCHAR(20)AS(JSON_VALUE(payload,'$.channel'))PERSISTENT,
PRIMARY KEY(event_id),
UNIQUE KEY uk_mf_event_key(event_key),
KEY ix_mf_event_account_time(account_id,occurred_at),
KEY ix_mf_event_channel(channel_code),
CONSTRAINT fk_mf_event_account FOREIGN KEY(account_id)REFERENCES mf_account(account_id),
CONSTRAINT chk_mf_event_amount CHECK(amount>=0),
CONSTRAINT chk_mf_event_payload CHECK(JSON_VALID(payload))
)ENGINE=InnoDB;

CREATE TABLE mf_summary(
summary_day DATE NOT NULL,
account_id INT NOT NULL,
event_count BIGINT NOT NULL,
net_amount DECIMAL(18,2)NOT NULL,
detail_json JSON NOT NULL,
PRIMARY KEY(summary_day,account_id),
CONSTRAINT fk_mf_summary_account FOREIGN KEY(account_id)REFERENCES mf_account(account_id)
)ENGINE=InnoDB;

CREATE TABLE mf_error_log(
log_id BIGINT NOT NULL AUTO_INCREMENT,
phase_name VARCHAR(80)NOT NULL,
sql_state CHAR(5)NULL,
error_no INT NULL,
message_text TEXT NULL,
PRIMARY KEY(log_id)
)ENGINE=InnoDB;

INSERT INTO mf_department(dept_id,parent_dept_id,dept_name,properties)VALUES
