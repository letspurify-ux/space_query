-- ============================================================================
-- SPACE QUERY MARIADB AUTO-FORMAT CERTIFICATION GAUNTLET III
-- Target: MariaDB 12.2+
--
-- Bitemporal + anonymous-block boss: simultaneous application/system time,
-- snapshot and range history, BEGIN NOT ATOMIC, direct HANDLER reads, upsert
-- RETURNING, standalone VALUES, Oracle-mode MINUS, JSON normalization,
-- PERCENTILE_DISC, ROWS EXAMINED, diagnostics, and rollback-only time slicing.
-- ============================================================================

DELIMITER ;
DROP DATABASE IF EXISTS sq_mariadb_format_cert_3;
CREATE DATABASE sq_mariadb_format_cert_3 CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE sq_mariadb_format_cert_3;
SET NAMES utf8mb4;
SET SESSION sql_mode='STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION';
SET @lexical_trap='BEGIN NOT ATOMIC; FOR SYSTEM_TIME AS OF x; HANDLER y READ `PRIMARY` NEXT; MINUS // inert';

# Comment trap: DELETE HISTORY FROM imaginary BEFORE SYSTEM_TIME TIMESTAMP '2000-01-01' //
/* String-looking syntax is inert: VALUES (1); RETURNING id; END NOT ATOMIC; */

CREATE TABLE mb3_contract(
contract_id INT NOT NULL,
valid_from DATE NOT NULL,
valid_to DATE NOT NULL,
customer_code VARCHAR(30)NOT NULL,
contract_status VARCHAR(20)NOT NULL,
amount DECIMAL(14,2)NOT NULL,
terms_doc JSON NOT NULL,
row_start TIMESTAMP(6)GENERATED ALWAYS AS ROW START,
row_end TIMESTAMP(6)GENERATED ALWAYS AS ROW END,
PERIOD FOR validity(valid_from,valid_to),
PERIOD FOR SYSTEM_TIME(row_start,row_end),
PRIMARY KEY(contract_id,validity WITHOUT OVERLAPS),
KEY ix_mb3_contract_customer(customer_code),
CONSTRAINT chk_mb3_contract_amount CHECK(amount>0),
CONSTRAINT chk_mb3_contract_terms CHECK(JSON_VALID(terms_doc))
)ENGINE=InnoDB WITH SYSTEM VERSIONING;

CREATE TABLE mb3_event(
event_id BIGINT NOT NULL AUTO_INCREMENT,
contract_id INT NOT NULL,
event_at DATETIME(6)NOT NULL,
event_type VARCHAR(30)NOT NULL,
event_amount DECIMAL(14,2)NOT NULL,
payload JSON NOT NULL,
PRIMARY KEY(event_id),
KEY ix_mb3_event_contract_time(contract_id,event_at),
CONSTRAINT chk_mb3_event_payload CHECK(JSON_VALID(payload))
)ENGINE=InnoDB;

CREATE TABLE mb3_rollup(
contract_id INT NOT NULL,
current_fragments BIGINT NOT NULL,
history_versions BIGINT NOT NULL,
event_count BIGINT NOT NULL,
event_total DECIMAL(18,2)NOT NULL,
evidence JSON NOT NULL,
PRIMARY KEY(contract_id)
)ENGINE=InnoDB;

CREATE TABLE mb3_direct(
direct_id INT NOT NULL,
payload VARCHAR(80)NOT NULL,
score INT NOT NULL,
PRIMARY KEY(direct_id),
KEY ix_mb3_direct_score(score)
)ENGINE=InnoDB;

CREATE TABLE mb3_error_log(
log_id BIGINT NOT NULL AUTO_INCREMENT,
phase_name VARCHAR(80)NOT NULL,
sql_state CHAR(5),
error_no INT,
message_text TEXT,
PRIMARY KEY(log_id)
)ENGINE=InnoDB;

DELIMITER //

CREATE OR REPLACE PROCEDURE mb3_assert(IN p_condition BOOLEAN,IN p_message VARCHAR(255))
BEGIN
IF IFNULL(p_condition,FALSE)=FALSE THEN SIGNAL SQLSTATE'45000'SET MESSAGE_TEXT=p_message;END IF;
END//

CREATE OR REPLACE FUNCTION mb3_contract_band(p_amount DECIMAL(14,2))
RETURNS VARCHAR(20)
DETERMINISTIC
RETURN CASE WHEN p_amount>=200 THEN'PLATINUM'WHEN p_amount>=100 THEN'GOLD'WHEN p_amount>=50 THEN'SILVER'ELSE'BRONZE'END//

CREATE OR REPLACE TRIGGER mb3_event_bi BEFORE INSERT ON mb3_event FOR EACH ROW
BEGIN
SET NEW.event_type=UPPER(TRIM(NEW.event_type));
IF NEW.event_amount<0 OR JSON_VALID(NEW.payload)=0 THEN
SIGNAL SQLSTATE'45000'SET MESSAGE_TEXT='invalid bitemporal event';
END IF;
END//

DELIMITER ;

INSERT INTO mb3_contract(contract_id,valid_from,valid_to,customer_code,contract_status,amount,terms_doc)VALUES
(1,'2026-01-01','2027-01-01','alpha','ACTIVE',100,JSON_OBJECT('plan','core','features',JSON_ARRAY('history','portion'))),
(2,'2026-01-01','2026-07-01','beta','ACTIVE',80,JSON_OBJECT('plan','starter','features',JSON_ARRAY('snapshot'))),
(2,'2026-07-01','2027-01-01','beta','ACTIVE',90,JSON_OBJECT('plan','renewal','features',JSON_ARRAY('snapshot','renewal'))),
(3,'2026-01-01','2027-01-01','gamma','ACTIVE',220,JSON_OBJECT('plan','enterprise','features',JSON_ARRAY('history','analytics')));

UPDATE mb3_contract FOR PORTION OF validity FROM'2026-03-01'TO'2026-06-01'
SET amount=125,terms_doc=JSON_SET(terms_doc,'$.campaign','spring','$.revision',2)
WHERE contract_id=1;

SET @history_cutover=NOW(6);
DO SLEEP(0.02);
UPDATE mb3_contract SET contract_status='REVIEWED',terms_doc=JSON_SET(terms_doc,'$.reviewed',TRUE)
WHERE contract_id=1 AND valid_from='2026-01-01';

