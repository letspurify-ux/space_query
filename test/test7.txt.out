PROMPT [0] Cleanup (ignore errors if objects do not exist)

BEGIN
  EXECUTE IMMEDIATE 'DROP TABLE oqt_t_order_item PURGE';
EXCEPTION WHEN OTHERS THEN NULL; END;
/
BEGIN
  EXECUTE IMMEDIATE 'DROP TABLE oqt_t_order_hdr PURGE';
EXCEPTION WHEN OTHERS THEN NULL; END;
/
