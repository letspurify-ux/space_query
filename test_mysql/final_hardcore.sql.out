);

-- Wave-4 self-verification.
CALL sq_hard_assert(
  @sq_hard_w4_walk_total = 56,
  'wave4 cursor walk total'
);
CALL sq_hard_assert(
  @sq_hard_w4_stacked_state = '45000'
